<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Microphone: wake word / speech recognition -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />

    <!-- Contacts: relationship mapping ("call my bro"), read-only, local-only use -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Phone calls. CALL_PHONE lets us place a call directly; if the user
         declines it, we fall back to ACTION_DIAL (no permission required,
         just pre-fills the dialer) - see ContactsBridge.kt -->
    <uses-permission android:name="android.permission.CALL_PHONE" />

    <!-- Floating assistant overlay -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <!-- Foreground service required to keep the assistant listening /
         showing its overlay reliably under modern Android background
         execution limits -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />

    <!-- Required on Android 13+ to show the foreground-service notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Allows the overlay service to keep listening briefly after screen off
         when a command is mid-flight; not used to defeat Doze in general -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Lets the app show the (standard, user-facing) "exempt this app
         from battery optimization" system dialog. The exemption is only
         ever requested via an explicit user action in Settings, never
         silently. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:label="Weby"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>

        <!-- Hosts the wake-word/STT loop and the floating overlay window.
             foregroundServiceType=microphone is required on Android 14+ to
             legally use the mic from a foreground service.
             stopWithTask=false + the onTaskRemoved() restart in
             OverlayService.kt together keep "app closed, say Weby" working
             when the user swipes Weby out of Recents. -->
        <service
            android:name=".assistant.OverlayService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="microphone" />

        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <!-- Package-visibility queries (Android 11+). We deliberately do NOT
         request QUERY_ALL_PACKAGES (a Play Store restricted permission) -
         instead we declare exactly the intent shapes we need to enumerate:
         anything launchable, so "Weby, open WhatsApp" can resolve targets
         without broad package visibility. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN"/>
            <category android:name="android.intent.category.LAUNCHER"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.CALL"/>
        </intent>
    </queries>
</manifest>
