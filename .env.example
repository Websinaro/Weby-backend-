# ---------------------------------------------
# Weby Backend - Environment Configuration
# Copy this file to .env and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------

NODE_ENV=development
PORT=3000
API_PREFIX=/api/v1

# PostgreSQL connection string
# Example: postgresql://user:password@localhost:5432/weby?schema=public
DATABASE_URL=

# JWT secrets - use long random strings (openssl rand -hex 64)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Token lifetimes (jsonwebtoken / ms style strings)
ACCESS_TOKEN_EXPIRES=15m
REFRESH_TOKEN_EXPIRES=30d

# Google Sign-In (server-side verification)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of allowed origins for CORS
CORS_ORIGIN=http://localhost:3000,http://localhost:8080

# AI Providers (server-side only, NEVER exposed to the client)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=meta-llama/Meta-Llama-3-8B-Instruct

# Default AI provider used by the router when the user has no preference
DEFAULT_AI_PROVIDER=gemini

# Rate limiting
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_RATE_LIMIT_MAX=10
GLOBAL_RATE_LIMIT_WINDOW_MS=60000
GLOBAL_RATE_LIMIT_MAX=120

# Logging
LOG_LEVEL=info
